# data (do not commit large files; use accessions)
*.fastq
*.fastq.gz
*.bam
*.bigwig
*.bw

# model weights / checkpoints (GB-scale, re-downloadable - see ENVIRONMENT.local.md)
RNA-FM_stuff/
*.pth
*.pt
*.ckpt
*.safetensors
*.npy
*.npz

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# machine-specific notes (local paths, personal setup) - keep out of the public repo
*.local.md

# os
.DS_Store
Thumbs.db
# Windows Explorer duplicates, e.g. "x - Copy.xlsx" made to dodge Excel's file lock
* - Copy.*

# claude code
# commit these (shared project config): .claude/settings.json,
# .claude/commands/, .claude/agents/, .claude/skills/
# ignore these (kept local / machine-specific / transient):
CLAUDE.md
.claude/settings.local.json
.claude/*.local.md
.claude/sessions/
.claude/shell-snapshots/
.claude/todos/
.claude/statsig/

# secrets
.env
.env.*
!.env.example
